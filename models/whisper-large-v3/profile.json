{
  "schema_version": 1,
  "profile_id": "caremojo-local-transcript-v1",
  "role": "deployment and evaluation contract; no private audio or transcript is stored here",
  "input": {
    "media": "audio",
    "sample_rate_hz": 16000,
    "channels": 1,
    "runtime_sample_types": ["signed-16-bit-pcm", "float32"],
    "window_seconds": 30,
    "observed_clip_seconds": 300,
    "language": "auto-or-caller-supplied",
    "task": "transcribe"
  },
  "output": {
    "type": "ordered-segments",
    "required_fields": ["start_ms", "end_ms", "text"],
    "optional_fields": ["language", "confidence", "speaker"],
    "timestamps_required": true,
    "arbitrary_natural_language_required": true
  },
  "privacy": {
    "raw_audio_leaves_device": false,
    "raw_transcript_leaves_device": false,
    "benchmark_artifacts_must_be_public_or_synthetic": true
  },
  "benchmark": {
    "primary_duration_seconds": 300,
    "secondary_duration_seconds": 30,
    "report": [
      "audio_seconds",
      "wall_seconds",
      "real_time_factor",
      "audio_seconds_per_wall_second",
      "encoder_seconds",
      "decoder_seconds",
      "cpu_percent",
      "peak_rss_kib",
      "swap_kib",
      "word_error_rate_or_character_error_rate",
      "timestamp_error"
    ]
  }
}
