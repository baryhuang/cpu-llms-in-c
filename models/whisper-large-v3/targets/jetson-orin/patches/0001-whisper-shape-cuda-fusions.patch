+void ggml_cuda_op_norm_fused_add(ggml_backend_cuda_context & ctx, ggml_tensor * norm_tensor,
+                                 ggml_tensor * mul_tensor, ggml_tensor * add_tensor) {
+    const ggml_tensor * src0  = norm_tensor->src[0];
+    const ggml_tensor * gamma = mul_tensor->src[0] == norm_tensor ? mul_tensor->src[1] : mul_tensor->src[0];
+    const ggml_tensor * beta  = add_tensor->src[0] == mul_tensor  ? add_tensor->src[1] : add_tensor->src[0];
+
+    const float * src0_d  = (const float *) src0->data;
+    const float * gamma_d = (const float *) gamma->data;
+    const float * beta_d  = (const float *) beta->data;
+    float * dst_d = (float *) add_tensor->data;
+    cudaStream_t stream = ctx.stream();
+
+    GGML_ASSERT(src0->type == GGML_TYPE_F32);
+    GGML_ASSERT(gamma->type == GGML_TYPE_F32);
+    GGML_ASSERT(beta->type == GGML_TYPE_F32);
+    GGML_ASSERT(add_tensor->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_nelements(gamma) == src0->ne[0]);
+    GGML_ASSERT(ggml_nelements(beta) == src0->ne[0]);
+
+    float eps;
+    memcpy(&eps, norm_tensor->op_params, sizeof(float));
+    GGML_ASSERT(eps >= 0.0f);
+
+    const size_t ts0 = ggml_type_size(src0->type);
+    GGML_ASSERT(src0->nb[0] == ts0);
+    const int64_t s01 = src0->nb[1] / ts0;
+    const int64_t s02 = src0->nb[2] / ts0;
+    const int64_t s03 = src0->nb[3] / ts0;
+
+    norm_mul_add_f32_cuda(src0_d, gamma_d, beta_d, dst_d,
+                          src0->ne[0], src0->ne[1], src0->ne[2], src0->ne[3],
+                          s01, s02, s03, eps, stream);
+}
