+        const int ncols, const int nrows, const int nchannels, const int nsamples,
+        const int64_t stride_row, const int64_t stride_channel, const int64_t stride_sample,
+        const float eps, cudaStream_t stream) {
+    const dim3 blocks_num(nrows, nchannels, nsamples);
+    if (ncols < 1024) {
+        const dim3 block_dims(WARP_SIZE, 1, 1);
+        norm_mul_add_f32<WARP_SIZE><<<blocks_num, block_dims, 0, stream>>>(x, gamma, beta, dst, ncols, stride_row, stride_channel, stride_sample, eps);
+    } else {
+        const dim3 block_dims(1024, 1, 1);
+        norm_mul_add_f32<1024><<<blocks_num, block_dims, 32 * sizeof(float2), stream>>>(x, gamma, beta, dst, ncols, stride_row, stride_channel, stride_sample, eps);
+    }
+}
