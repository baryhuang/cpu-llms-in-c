+// fused bias-add + GELU: dst = gelu(x + bias), bias is a contiguous row vector of
+// length ncols broadcast over rows (checked at the fusion site). __fadd_rn keeps
+// rounding identical to the unfused add -> gelu chain.
+static __global__ void add_bias_gelu_f32(const float * x, const float * bias, float * dst, const int ncols, const int k) {
+    ggml_cuda_pdl_lc();
+    const int i = blockDim.x*blockIdx.x + threadIdx.x;
+
+    if (i >= k) {
+        return;
+    }
+
+    ggml_cuda_pdl_sync();
+    dst[i] = op_gelu(__fadd_rn(x[i], bias[i % ncols]));
+}
+
+void ggml_cuda_op_add_gelu_fused(ggml_backend_cuda_context & ctx, ggml_tensor * add_tensor, ggml_tensor * gelu_tensor) {
+    const ggml_tensor * x    = add_tensor->src[0];
+    const ggml_tensor * bias = add_tensor->src[1];
+    cudaStream_t stream = ctx.stream();
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(bias->type == GGML_TYPE_F32);
+    GGML_ASSERT(gelu_tensor->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x));
+    GGML_ASSERT(ggml_is_contiguous(bias));
+
+    const int64_t k64 = ggml_nelements(add_tensor);
+    GGML_ASSERT(k64 <= INT32_MAX);
+    const int k = (int) k64;
+    const int ncols = add_tensor->ne[0];
+
+    const int num_blocks = (k + CUDA_NEG_BLOCK_SIZE - 1) / CUDA_NEG_BLOCK_SIZE;
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params((dim3)num_blocks, CUDA_NEG_BLOCK_SIZE, 0, stream);
+    ggml_cuda_kernel_launch(add_bias_gelu_f32, launch_params,
+        (const float *) x->data, (const float *) bias->data, (float *) gelu_tensor->data, ncols, k);
+}
